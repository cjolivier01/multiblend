workspace(name = "multiblend")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# System libraries as local repositories

# libtiff (headers are in multiarch include dir on Debian/Ubuntu)
new_local_repository(
    name = "libtiff",
    path = "/usr",
    build_file_content = """
cc_library(
    name = "tiff",
    hdrs = glob(["include/tiff*.h", "include/x86_64-linux-gnu/tiff*.h"], allow_empty = True),
    includes = ["include", "include/x86_64-linux-gnu"],
    linkopts = [
        "-L/usr/lib/x86_64-linux-gnu",
        "-L/usr/lib",
        "-Wl,-rpath,/usr/lib/x86_64-linux-gnu",
        "-ltiff",
        "-lwebp",
        "-lsharpyuv",
        "-lLerc",
        "-ljbig",
        "-ldeflate",
        "-lz",
    ],
    visibility = ["//visibility:public"],
)
""",
)

